(* Ollin — formal grammar
   Source of truth: syntax.ol
   Maintained by: Claude — update it after every change to syntax.ol

   This file is THE reference for the language's syntax and semantics. The (* ... *)
   comments state the semantic rules attached to each production. CLAUDE.md documents
   the internal implementation only.

   Statement terminators: every statement ends with a newline. Inside brackets, square
   brackets and braces, newlines are ignored (implicit continuation).
   The ';' character is ONLY the interval separator in rangeLit. A ';' outside a
   bracketed context is an error. *)

program        = { stmt } EOF ;

stmt           = varDecl
               | globalDecl
               | constDecl
               | whileStmt
               | doStmt
               | forStmt
               | ifStmt
               | tryStmt
               | switchStmt
               | throwStmt
               | funcDecl
               | classDecl
               | enumDecl
               | returnStmt
               | importStmt
               | assignStmt
               | exprStmt ;

importStmt     = "import" STRING [ "as" IDENT ] NL ;
                 (* the path is resolved against the DIRECTORY of the importing file (an absolute
                    path is taken as it is), then normalised — "." and ".." collapsed. That resolved
                    path is the module's identity: importing the same file twice does nothing the
                    second time, whichever way it was written *)
                 (* the extension may be left out: "utils" reads utils.ol *)
                 (* WITHOUT `as`, the module's top-level names are injected into the importing
                    scope; WITH `as`, they are gathered as the fields of a map of that name. The
                    names injected are those DECLARED at the module's top level: var, const, func,
                    class and enum *)
                 (* what crosses the boundary, and what does not:
                      a `global` of either file is shared, so a module can fill the host's state;
                      a function of the host reads a `const` of the module, and the other way round
                        is NOT true — a `const` of the host is a local of its main body, invisible
                        to a module (a constant a module needs must live in the module);
                      the engine's entry points — setup, update, draw — and the input callbacks
                        (mouse.*, touch.*, keyboard.*) are read from the ENTRY file only: declaring
                        them in a module has no effect *)

enumDecl       = "enum" enumTarget [ enumItem { "," enumItem } [ "," ] ] "end" NL ;
enumTarget     = IDENT { "." IDENT } ;
enumItem       = IDENT [ "=" expr ] ;
                 (* builds a MAP whose keys are the items; newlines between items are free
                    (NL is not a token), and a trailing comma is tolerated, which suits a
                    vertical list *)
                 (* the target: a bare IDENT is a GLOBAL variable (like a class, so a forward
                    reference is possible); a path a.b writes the field b of the map a *)
                 (* NUMBERING — an item with no value takes the counter, which starts at 1 and
                    advances by 1; an integer LITERAL (a sign is allowed) sets the value and
                    restarts the counter at value+1; ANY OTHER expression is accepted as a value
                    but leaves the counter where it is, not being computable at compile time.
                    For instance A, B = "x", C gives 1, "x", 2 *)
                 (* a value may be of any type (a number, a string, an object, an array, a
                    function); two items of the same value are aliases, and are allowed; two
                    items of the same NAME are a compile error *)
                 (* the map is FROZEN: every indexed write is refused — a compile error when the
                    target is visibly the enum, a runtime error otherwise, through an alias or a
                    computed key. The freeze is SHALLOW: an object or an array HELD BY the enum
                    stays mutable *)
                 (* for reading, an enum is an ordinary map: access, len, iteration *)

classDecl      = "class" IDENT [ "extends" IDENT ] NL { method } "end" NL ;
method         = [ "static" ] "func" IDENT "(" [ params ] ")" NL { stmt } "end" NL ;
                 (* without "static": an instance method — the implicit first parameter "self" sits in R[0] *)
                 (* with "static": a class method — no self, callable as Class.m() or instance.m() *)
                 (* "func init(...)" is the constructor, always an instance method *)
                 (* the special methods: init, __str, __add, __sub, __mul, __div, __mod, __neg, __eq, __lt, __le *)

methodCall     = expr "." IDENT [ "?" ] "(" [ expr { "," expr } ] ")" ;
superCall      = "super" "." IDENT [ "?" ] "(" [ expr { "," expr } ] ")" ;

varDecl        = "var" IDENT { "," IDENT } [ "=" expr { "," expr } ] NL ;
                 (* `var` is MANDATORY to create a variable, and it only ever creates locals *)
                 (* with no "=" the value is nil; with fewer values than names, the extra names are nil *)
                 (* LEXICAL scope: a local is only visible FROM its declaration on. Above its
                    line the name resolves to the enclosing global or upvalue, or to "undeclared
                    variable" when there is none. Hence `var x = x` initialises from the outer x.
                    Nested functions, on the other hand, are visible forwards within their scope,
                    which allows recursion and mutual references. *)
globalDecl     = "global" IDENT { "," IDENT } [ "=" expr { "," expr } ] NL ;
                 (* `global` declares global variables, visible throughout the program *)
                 (* declarable anywhere, at the top level or inside a function; read and written anywhere *)
                 (* a `var` local of the same name shadows the global from its declaration on *)
constDecl      = "const" IDENT { "," IDENT } "=" expr { "," expr } NL ;
                 (* `const` declares an immutable local; the initialisation is mandatory *)
                 (* any later attempt to assign to it is a compile error *)
                 (* a constant can be captured read-only by a closure *)
whileStmt      = "while" expr "do" { stmt } "end" NL ;
doStmt         = "do" { stmt } "end" NL ;
                 (* a free lexical block: the variables declared inside are local to the block and
                    are not visible after "end". The closures captured stay valid. *)
forStmt        = "for" IDENT "=" expr "," expr [ "," expr ] "do" { stmt } "end" NL
               | "for" IDENT [ "," IDENT ] "in" expr "do" { stmt } "end" NL ;
                 (* numeric: "for i=start,end[,step]"; the step is optional, 1 by default, and a
                    negative step counts down *)
                 (* iterator: "for v in it" gives the primary value — the element for an array or
                    a range, the key for a map *)
                 (*           "for k,v in it" gives the key or index, plus the value *)
                 (* the iterables: an array, a map (as a snapshot), a range; "break" is valid in all of them *)
                 (* the loop variable, or variables, are LOCAL to the loop: they are not visible
                    afterwards, and referring to one is an error; an outer variable of the same
                    name is shadowed, then restored. Changing them inside the body does not affect
                    the iteration. *)
                 (* each ITERATION has variables of its own: a closure created in the body captures
                    the loop variable and the body's locals as they were on ITS turn, not their
                    final value *)
ifStmt         = "if" expr "then" { stmt }
                 { "elseif" expr "then" { stmt } }
                 [ "else" { stmt } ]
                 "end" NL ;
             (* there is no "else if" sugar: an elseif is written 'elseif'. An 'else' followed
                by an 'if' is an else branch holding a nested if block — an ordinary statement,
                with its own 'end'. *)
tryStmt        = "try" { stmt } "catch" IDENT { stmt } [ "else" { stmt } ] "end" NL ;
switchStmt     = "switch" expr NL { "case" expr { "," expr } NL { stmt } } [ "else" NL { stmt } ] "end" NL ;
                 (* the subject is evaluated ONCE; a case value is an EXPRESSION, and the values
                    are evaluated in order, only until one is equal to the subject (the equality of
                    "==", so 1 matches 1.0 but not "1"). A branch does NOT fall through.
                    "break" is REFUSED inside a switch: with no fall-through it has nothing to
                    leave, and inside a loop it would read as leaving that loop while it could only
                    leave the switch. "continue" passes through and reaches the loop, and a loop
                    written inside a branch keeps its own "break". *)
throwStmt      = "throw" expr NL ;
funcDecl       = "func" IDENT [ "." IDENT ] "(" [ params ] ")" NL { stmt } "end" NL ;
               (* "func obj.field(...) ... end" is sugar for "obj.field = func(...) ... end":
                  it defines a function on a field of a map or a module, as in
                  func keyboard.keypressed(key) ... end *)
params         = param { "," param } [ "," "..." ] | "..." ;
param          = IDENT [ "=" literal ] ;
                 (* "..." among the parameters makes the function variadic. In the BODY, `...`
                    names the variadic arguments. Multi-value expansion, as in Lua: in LAST
                    position of a list — call arguments `f(a, ...)`, array elements `[x, ...]`,
                    `return a, ...`, destructuring `var a, b = ...` — `...` expands to EVERY
                    vararg. A CALL in last position likewise expands to all of its return values
                    (`f(g())`, `return g()`, `[x, g()]`). Anywhere else — a non-final position, or
                    `var x = ...` — the expression is adjusted to ONE value: `...` gives the first
                    vararg or nil, and a call gives its first value.
                    A known limit: `object.method(...)` does not expand yet, and is adjusted to
                    one value. *)
returnStmt     = "return" [ retvals ] NL ;
retvals        = "..."
               | expr { "," expr } [ "," "..." ] ;
assignStmt     = IDENT ( "=" | "+=" | "-=" | "*=" | "/=" | "%=" ) expr NL ;
                 (* the semantic rule: IDENT must have been declared by "var" or "global", or it is an error *)
                 (* "var" gives a local, "global" a global, in the VM's shared table *)
indexAssign    = IDENT "[" expr "]" ( "=" | "+=" | "-=" | "*=" | "/=" | "%=" ) expr NL
               | IDENT "." IDENT   ( "=" | "+=" | "-=" | "*=" | "/=" | "%=" ) expr NL ;
exprStmt       = expr NL ;

expr           = logical ;
logical        = logicalAnd { "or" logicalAnd } ;
logicalAnd     = bitwiseOr { "and" bitwiseOr } ;
             (* "and" and "or" SHORT-CIRCUIT and return a VALUE:
                "a and b" gives a when a is falsy, otherwise b, which is not evaluated when a is falsy;
                "a or b" gives a when a is truthy, otherwise b, which is not evaluated when a is truthy.
                So `f and f()` and `obj and obj.x` are safe.
                Falsy: false, nil, 0, "", [], {} — "empty is false". *)
bitwiseOr      = bitwiseXor { "|" bitwiseXor } ;
bitwiseXor     = bitwiseAnd { "~" bitwiseAnd } ;
             (* a binary "~" is a bitwise XOR; a unary "~" is NOT, see unary *)
bitwiseAnd     = comparison { "&" comparison } ;
comparison     = shift { ( ">" | "<" | ">=" | "<=" | "==" | "<>" ) shift } ;
             (* chained comparisons: 1 < x < 10 is (1 < x) and (x < 10), with x evaluated once *)
             (* < > <= >= work on numbers (INT and FLOAT) OR on two strings, in byte-wise
                lexicographic order: "abc" < "abd", "abc" < "abcd" *)
             (* == and <> compare scalars by value (INT equals FLOAT for the same number, strings
                by content); a map, an array and a class compare by REFERENCE, hence by identity,
                so {} == {} is false. Equality by value comes from a class instance with __eq,
                looked up on the left operand and called even when both operands are the same
                instance. *)
shift          = additive { ( "<<" | ">>" ) additive } ;
additive       = multiplicative { ( "+" | "-" ) multiplicative } ;
             (* "+" is numeric addition, or string concatenation *)
             (* promotion: INT op INT gives INT; INT op FLOAT gives FLOAT; "/" always gives FLOAT *)
             (* an int64 overflow wraps silently *)
multiplicative = unary { ( "*" | "/" | "//" | "%" ) unary } ;
             (* "//" is floor division: INT//INT gives INT, FLOAT//FLOAT gives FLOAT *)
refExpr        = "ref" IDENT { "." IDENT } ;
                 (* PASSING BY REFERENCE. It gives a function, in Ollin or native, the means to
                    READ and to WRITE the variable named. The main use is binding a variable to a
                    widget — ui.checkbox("Grid", ref grid) *)
                 (* The target is a name or a path of fields. Indexing, `ref t[i]`, is refused:
                    the path being re-evaluated on every access, the reference would follow the
                    changes of i. *)
                 (* The name must be DECLARED: `ref unknown` is a compile error, unlike a name
                    passed as a string. *)
                 (* It evaluates to an object {__ref: true, get: func, set: func}: the script
                    reads r.get() and writes r.set(v), and `__ref` serves the validation on the
                    native side. The target itself is read and written AS USUAL — a reference
                    changes nothing about the use of the variable. *)
                 (* A LOCAL target: the reference stays valid after the block ends, its upvalue
                    having been closed over a copy, but a write no longer reaches anything. *)
                 (* The cost: two closures and a map per evaluation, so it is to be avoided in a
                    tight loop. *)

unary          = ( "-" | "not" | "~" | "#" ) unary | refExpr | power ;
             (* a unary "~" is a bitwise NOT; "#" is sugar, "#expr" being "len(expr)" *)
power          = primary ( "^" unary ) ? ;
             (* "^" is exponentiation, right-associative: INT^INT with a non-negative exponent
                gives INT, and FLOAT otherwise *)
             (* "^" binds tighter than unary minus: -2^2 is -(2^2), hence -4; 2^2^3 is 2^(2^3),
                hence 256; and 2 ^ -1 is 0.5. ('**' no longer exists.) *)
primary        = NUMBER
               | STRING
               | BOOL
               | NIL
               | "super" "." IDENT "(" [ expr { "," expr } ] ")"
               | IDENT { ( "[" expr "]" | "." IDENT [ "(" [ expr { "," expr } ] ")" ] ) }
               | call  { ( "[" expr "]" | "." IDENT [ "(" [ expr { "," expr } ] ")" ] ) }
               | mapLit { ( "[" expr "]" | "." IDENT [ "(" [ expr { "," expr } ] ")" ] ) }
               | arrayLit { ( "[" expr "]" ) }
               | rangeLit
               | lambdaExpr
               | "..."
               | "(" expr ")" ;

lambdaExpr     = "func" "(" [ params ] ")" NL { stmt } "end" ;
               (* an anonymous function, usable as an expression; it captures upvalues as any closure does *)
               (* "expr.method(args)" is a method call, with an implicit self *)

mapLit         = "{" [ mapEntry { "," mapEntry } ] "}" ;
               (* newlines are allowed between entries: the implicit continuation applies inside {} *)
mapEntry       = ( STRING | IDENT | "[" expr "]" ) ":" expr ;
                 (* a literal key: IDENT, STRING and ["STRING"] are equivalent, the key being the string *)
                 (*   { ref: 12 } is { "ref": 12 } is { ["ref"]: 12 }, the key being "ref" *)
                 (* a KEYWORD spells a name here, and after a "." as well: { end: 1 }, m.in, ref c.class *)
                 (*   the exceptions are true, false and nil, which carry a value: use ["true"] for those *)
                 (* a computed key: [expr] evaluates expr at run time and uses its value as the key *)
                 (*   { [ref]: 12 } takes the key from the variable ref, of any Value type: a string, an int, … *)
                 (* access: m["k"] and m.k are equivalent, for reading, writing and compound assignment *)
                 (* copy semantics: reference counting, with no clone; an empty map is falsy, "empty is false" *)
arrayLit       = "[" [ expr { "," expr } ] "]" ;
             (* shared by reference, through reference counting; an empty array is falsy, "empty is false" *)
rangeLit       = ( "[" | "]" ) expr ";" expr [ ";" expr ] ( "]" | "[" ) ;
             (* [a;b] is inclusive-inclusive, [a;b[ inclusive-exclusive, ]a;b] exclusive-inclusive,
                ]a;b[ exclusive-exclusive *)
             (* the step is optional, [a;b;step]; ranges are first-class and iterable *)
call           = IDENT [ "?" ] "(" [ expr { "," expr } ] ")" ;
             (* the optional call f?(args) is `if f then f(args) else nil`.
                A falsy f (false, nil, 0, "", [], {}) means no call, a nil result, and ARGUMENTS
                LEFT UNEVALUATED; a callable f is called; a truthy, non-callable f is an error, as
                in a standard call.
                It is implemented with JUMP_IF_FALSE plus a standard call, with no opcode of its own.
                It applies to every form: f?(), expr?() such as m["cb"]?(), obj.m?() — where self
                is injected and a missing method gives nil — and super.m?(). *)

line_comment   = "##" { any \ newline } ;
block_comment  = "###" { any } "###" ;

(* NL is a newline, and it terminates every statement.
   The implicit continuation applies inside brackets, square brackets and braces: a
   newline does not terminate a statement there.
   ';' is the interval separator in rangeLit, and is forbidden anywhere else. *)

NUMBER         = ( digit { [ "_" ] digit } [ "." [ digit { [ "_" ] digit } ] ] [ exponent ] )
               | ( "." digit { [ "_" ] digit } [ exponent ] )
               | ( ( "0x" | "0X" ) hexDigit { [ "_" ] hexDigit } )
               | ( ( "0o" | "0O" ) octDigit { [ "_" ] octDigit } )
               | ( ( "0b" | "0B" ) binDigit { [ "_" ] binDigit } ) ;
exponent       = ( "e" | "E" ) [ "+" | "-" ] digit { digit } ;
             (* '_' only between two digits (1_000 == 1000); integer literals become int64,
                everything else a float *)
             (* scientific notation: an exponent (e or E) makes the literal a float (1e3 == 1000.0,
                6.022e23, 2e-3 == 0.002); the exponent admits no '_' and requires at least one digit *)
             (* 0x.. hex, 0o.. octal, 0b.. binary are always integers (0xFF==255, 0o10==8,
                0b1010==10), and take no exponent *)
             (* a literal immediately followed by an alphanumeric character, a '.' or a '_' is an error *)
hexDigit       = digit | "a" | ... | "f" | "A" | ... | "F" ;
octDigit       = "0" | ... | "7" ;
binDigit       = "0" | "1" ;
STRING         = '"' { strChar } '"' ;
strChar        = any \ ( '"' | '{' | LF ) | "\{" | "{" expr [ ":" fmtSpec ] "}" | placeholder ;
placeholder    = "{" [ digit { digit } ] [ ":" fmtSpec ] "}" ;
fmtSpec        = { "-" | "+" | " " | "#" | "0" | digit | "." } convChar ;
convChar       = "d" | "i" | "o" | "u" | "x" | "X" | "c"
               | "e" | "E" | "f" | "F" | "g" | "G" | "a" | "A" | "s" ;
                 (* "{" expr [":"fmtSpec] "}" is INTERPOLATION: it evaluates expr and inserts its
                    representation; fmtSpec, a C conversion spec without the '%', applies a format,
                    as in {x:.3f} or {n:04x}. The separating ':' is the one at the TOP level: the
                    ':' of a nested map literal {a:1} is preserved.
                    A placeholder is "{" either empty or an integer of at least 1, [":"fmtSpec] "}"
                    — {}, {1}, {2:.3f} — with a 1-based index: it is left LITERAL in the string, for
                    printf's POSITIONAL substitution, to be filled by the arguments. "\{" is a
                    literal brace.
                    A string with no interpolation is a STRING token, and it may hold positional
                    placeholders; a string with "{expr}" produces an INTERP_START/MID/END sequence.
                    The formatting of {expr:spec} and of {N:spec} shares one engine, the internal
                    __fmt function and printf. *)
BOOL           = "true" | "false" ;
             (* A TYPE OF ITS OWN, sealed: `true` is not the integer 1, so true <> 1 and
                false <> 0. Arithmetic and the ordering comparisons on a boolean are a runtime
                error, as they are on nil.
                It is produced by `not`, by the comparisons (== <> < > <= >=) and by the literals;
                it displays as "true" and "false".
                "Empty is false" still holds: 0, "", [] and {} are falsy without being false.
                There is no `bool(v)` conversion — `not not v` stands in for it. *)
NIL            = "nil" ;
IDENT          = ( letter | "_" ) { letter | digit | "_" } ;

digit          = "0" | ... | "9" ;
letter         = "a" | ... | "z" | "A" | ... | "Z" ;

(* Ollin — grammaire formelle
   Source de vérité : syntax.ol
   Maintenu par : Claude — mettre à jour après chaque évolution de syntax.ol

   Ce fichier est LA référence de la syntaxe et de la sémantique du langage.
   Les commentaires (* ... *) précisent les règles sémantiques attachées à
   chaque production. CLAUDE.md ne documente que l'implémentation interne.

   Terminateurs de statements : chaque statement se termine par un saut de ligne.
   À l'intérieur des parenthèses, crochets et accolades, les sauts de ligne
   sont ignorés (continuation implicite).
   Le caractère ';' est UNIQUEMENT le séparateur d'intervalle dans rangeLit.
   Un ';' hors d'un contexte entre crochets/parenthèses est une erreur. *)

program        = { stmt } EOF ;

stmt           = varDecl
               | globalDecl
               | constDecl
               | whileStmt
               | doStmt
               | forStmt
               | ifStmt
               | tryStmt
               | switchStmt
               | throwStmt
               | funcDecl
               | classDecl
               | enumDecl
               | returnStmt
               | importStmt
               | assignStmt
               | exprStmt ;

importStmt     = "import" STRING [ "as" IDENT ] NL ;

enumDecl       = "enum" enumTarget [ enumItem { "," enumItem } [ "," ] ] "end" NL ;
enumTarget     = IDENT { "." IDENT } ;
enumItem       = IDENT [ "=" expr ] ;
                 (* crée une MAP dont les clés sont les éléments ; les sauts de ligne
                    entre éléments sont libres (les NL ne sont pas des tokens), et la
                    virgule finale est tolérée — pratique en liste verticale *)
                 (* cible : IDENT seul = variable GLOBALE (comme une classe, référence
                    en avant possible) ; chemin a.b = écrit le champ b de la map a *)
                 (* NUMÉROTATION — un élément sans valeur prend le compteur, qui part de 1
                    et avance de 1 ; un LITTÉRAL entier (signé permis) fixe la valeur et
                    fait repartir le compteur à valeur+1 ; toute AUTRE expression est
                    acceptée comme valeur mais laisse le compteur inchangé (elle n'est
                    pas évaluable à la compilation). Ex. : A, B = "x", C  →  1, "x", 2 *)
                 (* une valeur peut être de tout type (nombre, chaîne, objet, tableau,
                    fonction) ; deux éléments de même valeur = alias, permis ; deux
                    éléments de même NOM = erreur de compilation *)
                 (* la map est GELÉE : toute écriture indexée est refusée (erreur de
                    compilation si la cible est visiblement l'enum, erreur d'exécution
                    sinon — alias, clé calculée). Le gel est SUPERFICIEL : un objet ou
                    un tableau CONTENU dans l'enum reste modifiable *)
                 (* en lecture, un enum est une map ordinaire : accès, len, itération *)

classDecl      = "class" IDENT [ "extends" IDENT ] NL { method } "end" NL ;
method         = [ "static" ] "func" IDENT "(" [ params ] ")" NL { stmt } "end" NL ;
                 (* sans "static" : méthode d'instance — premier param implicite "self" en R[0] *)
                 (* avec "static" : méthode de classe — pas de self, appelable via Classe.m() ou instance.m() *)
                 (* "func init(...)" = constructeur (toujours instance) *)
                 (* méthodes spéciales : init, __str, __add, __sub, __mul, __div, __mod, __neg, __eq, __lt, __le *)

methodCall     = expr "." IDENT [ "?" ] "(" [ expr { "," expr } ] ")" ;
superCall      = "super" "." IDENT [ "?" ] "(" [ expr { "," expr } ] ")" ;

varDecl        = "var" IDENT { "," IDENT } [ "=" expr { "," expr } ] NL ;
                 (* `var` est OBLIGATOIRE pour créer une variable, et ne crée que des locales *)
                 (* sans "=" → nil ; moins de valeurs que de noms → les noms en trop valent nil *)
                 (* portée LEXICALE : la locale n'est visible qu'À PARTIR de sa déclaration.
                    Avant sa ligne, le nom résout au global/upvalue englobant, ou « undeclared
                    variable » s'il n'existe pas. Ainsi `var x = x` initialise avec le x
                    extérieur. (Les fonctions imbriquées, elles, sont visibles en avant dans
                    leur portée → récursion/référence mutuelle.) *)
globalDecl     = "global" IDENT { "," IDENT } [ "=" expr { "," expr } ] NL ;
                 (* `global` déclare des variables globales, visibles dans tout le programme *)
                 (* déclarable n'importe où (top-level ou dans une fonction) ; lue/écrite partout *)
                 (* une locale `var` de même nom masque le global à partir de sa déclaration *)
constDecl      = "const" IDENT { "," IDENT } "=" expr { "," expr } NL ;
                 (* `const` déclare une locale immuable ; initialisation obligatoire *)
                 (* toute tentative d'assignation ultérieure est une erreur de compilation *)
                 (* une constante peut être capturée en lecture seule par une closure *)
whileStmt      = "while" expr "do" { stmt } "end" NL ;
doStmt         = "do" { stmt } "end" NL ;
                 (* bloc lexical libre : les variables déclarées à l'intérieur sont locales au bloc
                    et ne sont pas visibles après "end". Les closures capturées restent valides. *)
forStmt        = "for" IDENT "=" expr "," expr [ "," expr ] "do" { stmt } "end" NL
               | "for" IDENT [ "," IDENT ] "in" expr "do" { stmt } "end" NL ;
                 (* numérique : "for i=start,end[,step]" ; step optionnel, défaut 1 ; step<0 décompte *)
                 (* itérateur : "for v in it" → valeur primaire (élément pour array/range, clé pour map) *)
                 (*             "for k,v in it" → clé/index + valeur *)
                 (* itérables : array, map (snapshot), range ; "break" valide partout *)
                 (* la/les variable(s) de boucle sont LOCALES à la boucle : non visibles
                    après (y référer = erreur) ; une variable externe de même nom est
                    masquée puis restaurée. Les modifier dans le corps n'affecte pas
                    l'itération. *)
                 (* chaque ITÉRATION a ses propres variables : une closure créée dans le
                    corps capture la variable de boucle et les locales du corps telles
                    qu'elles étaient à SON tour, pas leur valeur finale *)
ifStmt         = "if" expr "then" { stmt }
                 { "elseif" expr "then" { stmt } }
                 [ "else" { stmt } ]
                 "end" NL ;
             (* pas de sucre "else if" : un elseif s'écrit 'elseif'. Un 'else' suivi
                d'un 'if' est une branche else contenant un bloc if imbriqué (statement
                normal, avec son propre 'end'). *)
tryStmt        = "try" { stmt } "catch" IDENT { stmt } [ "else" { stmt } ] "end" NL ;
switchStmt     = "switch" expr NL { "case" expr { "," expr } NL { stmt } } [ "else" NL { stmt } ] "end" NL ;
throwStmt      = "throw" expr NL ;
funcDecl       = "func" IDENT [ "." IDENT ] "(" [ params ] ")" NL { stmt } "end" NL ;
               (* "func obj.field(...) ... end" est un sucre pour
                  "obj.field = func(...) ... end" : définit une fonction sur un champ
                  de map/module (ex. func keyboard.keypressed(key) ... end) *)
params         = param { "," param } [ "," "..." ] | "..." ;
param          = IDENT [ "=" literal ] ;
                 (* "..." dans les paramètres = fonction variadique. Dans le CORPS, `...`
                    désigne les arguments variadiques. Expansion multi-valeurs (modèle Lua) :
                    en DERNIÈRE position d'une liste — arguments d'appel `f(a, ...)`, éléments
                    de tableau `[x, ...]`, `return a, ...`, destructuration `var a, b = ...` —
                    `...` s'étend à TOUTES les varargs. Un APPEL en dernière position s'étend de
                    même à toutes ses valeurs de retour (`f(g())`, `return g()`, `[x, g()]`).
                    Ailleurs (position non finale, ou `var x = ...`), l'expression est ajustée à
                    UNE valeur : `...` → 1ʳᵉ vararg ou nil ; un appel → sa 1ʳᵉ valeur.
                    Limite connue : `objet.methode(...)` n'étend pas encore (ajusté à 1 valeur). *)
returnStmt     = "return" [ retvals ] NL ;
retvals        = "..."
               | expr { "," expr } [ "," "..." ] ;
assignStmt     = IDENT ( "=" | "+=" | "-=" | "*=" | "/=" | "%=" ) expr NL ;
                 (* règle sémantique : IDENT doit avoir été déclaré par "var" ou "global" — sinon erreur *)
                 (* "var" → locale ; "global" → globale (table VM partagée) *)
indexAssign    = IDENT "[" expr "]" ( "=" | "+=" | "-=" | "*=" | "/=" | "%=" ) expr NL
               | IDENT "." IDENT   ( "=" | "+=" | "-=" | "*=" | "/=" | "%=" ) expr NL ;
exprStmt       = expr NL ;

expr           = logical ;
logical        = logicalAnd { "or" logicalAnd } ;
logicalAnd     = bitwiseOr { "and" bitwiseOr } ;
             (* "and"/"or" COURT-CIRCUITENT et renvoient une VALEUR :
                "a and b" → a si a est falsy, sinon b (b non évalué si a falsy) ;
                "a or b"  → a si a est truthy, sinon b (b non évalué si a truthy).
                Donc `f and f()` ou `obj and obj.x` sont sûrs.
                Falsy : false, nil, 0, "", [], {} — « le vide est faux ». *)
bitwiseOr      = bitwiseXor { "|" bitwiseXor } ;
bitwiseXor     = bitwiseAnd { "~" bitwiseAnd } ;
             (* "~" binaire = XOR bit-à-bit ; "~" unaire = NOT, voir unary *)
bitwiseAnd     = comparison { "&" comparison } ;
comparison     = shift { ( ">" | "<" | ">=" | "<=" | "==" | "<>" ) shift } ;
             (* comparaisons chaînées : 1 < x < 10  ≡  (1 < x) and (x < 10), x évalué une fois *)
             (* < > <= >= : sur nombres (INT/FLOAT) OU sur deux strings (ordre
                lexicographique par octets : "abc" < "abd", "abc" < "abcd") *)
             (* == / <> : valeurs scalaires comparées par valeur (INT==FLOAT si même nombre,
                strings par contenu) ; map / array / classe comparés par RÉFÉRENCE (même objet).
                {} == {} → faux. Égalité par valeur : instance de classe avec __eq (cherché sur
                l'opérande gauche, appelé même si les deux opérandes sont la même instance). *)
shift          = additive { ( "<<" | ">>" ) additive } ;
additive       = multiplicative { ( "+" | "-" ) multiplicative } ;
             (* "+" : addition numérique ou concaténation de strings *)
             (* promotion : INT op INT → INT ; INT op FLOAT → FLOAT ; "/" → toujours FLOAT *)
             (* overflow int64 → wrapping silencieux *)
multiplicative = unary { ( "*" | "/" | "//" | "%" ) unary } ;
             (* "//" : division entière plancher (floor) — INT//INT → INT, FLOAT//FLOAT → FLOAT *)
refExpr        = "ref" IDENT { "." IDENT } ;
                 (* PASSAGE PAR RÉFÉRENCE. Donne à une fonction (Ollin ou native) le
                    moyen de LIRE et d'ÉCRIRE la variable désignée. Usage principal :
                    lier une variable à un widget — ui.checkbox("Grille", ref grille) *)
                 (* La cible est un nom ou un chemin de champs. L'indexation `ref t[i]`
                    est refusée : le chemin étant réévalué à chaque accès, la référence
                    suivrait les changements de i. *)
                 (* Le nom doit être DÉCLARÉ : `ref inconnue` est une erreur de
                    compilation, contrairement à un nom passé sous forme de chaîne. *)
                 (* Vaut un objet {__ref: true, get: func, set: func} : le script lit
                    r.get() et écrit r.set(v) ; `__ref` sert à la validation côté natif.
                    La cible, elle, se lit et s'écrit NORMALEMENT — une référence ne
                    change rien à l'usage de la variable elle-même. *)
                 (* Cible LOCALE : la référence reste valide après la sortie du bloc
                    (upvalue fermée sur une copie) mais l'écriture ne remonte plus. *)
                 (* Coût : deux fermetures + une map par évaluation → à éviter dans une
                    boucle serrée. *)

unary          = ( "-" | "not" | "~" | "#" ) unary | refExpr | power ;
             (* "~" unaire = NOT bit-à-bit ; "#" : sucre syntaxique — "#expr" ≡ "len(expr)" *)
power          = primary ( "^" unary ) ? ;
             (* "^" : exponentiation, associatif à droite — INT^INT(≥0) → INT ; sinon FLOAT *)
             (* "^" lie plus fort que le moins unaire : -2^2 == -(2^2) == -4 ; 2^2^3 = 2^(2^3) = 256 ;
                2 ^ -1 == 0.5. ('**' n'existe plus.) *)
primary        = NUMBER
               | STRING
               | BOOL
               | NIL
               | "super" "." IDENT "(" [ expr { "," expr } ] ")"
               | IDENT { ( "[" expr "]" | "." IDENT [ "(" [ expr { "," expr } ] ")" ] ) }
               | call  { ( "[" expr "]" | "." IDENT [ "(" [ expr { "," expr } ] ")" ] ) }
               | mapLit { ( "[" expr "]" | "." IDENT [ "(" [ expr { "," expr } ] ")" ] ) }
               | arrayLit { ( "[" expr "]" ) }
               | rangeLit
               | lambdaExpr
               | "..."
               | "(" expr ")" ;

lambdaExpr     = "func" "(" [ params ] ")" NL { stmt } "end" ;
               (* fonction anonyme utilisable comme expression ; capture des upvalues comme toute closure *)
               (* "expr.method(args)" = appel de méthode avec self implicite *)

mapLit         = "{" [ mapEntry { "," mapEntry } ] "}" ;
               (* sauts de ligne autorisés entre les entrées — la continuation implicite s'applique à l'intérieur de {} *)
mapEntry       = ( STRING | IDENT | "[" expr "]" ) ":" expr ;
                 (* clé littérale : IDENT, STRING et ["STRING"] sont équivalents → clé = la string *)
                 (*   { ref: 12 } ≡ { "ref": 12 } ≡ { ["ref"]: 12 }  (clé = "ref") *)
                 (* clé calculée : [expr] évalue expr à l'exécution et utilise sa valeur comme clé *)
                 (*   { [ref]: 12 } → clé = valeur de la variable ref (toute Value : string, int, …) *)
                 (* accès : m["k"] et m.k sont équivalents (lecture, écriture, compound) *)
                 (* sémantique de copie : référence comptée (pas de clone) ; map vide → falsy (« le vide est faux ») *)
arrayLit       = "[" [ expr { "," expr } ] "]" ;
             (* partagé par référence (comptage de référence) ; array vide → falsy (« le vide est faux ») *)
rangeLit       = ( "[" | "]" ) expr ";" expr [ ";" expr ] ( "]" | "[" ) ;
             (* [a;b] incl-incl, [a;b[ incl-excl, ]a;b] excl-incl, ]a;b[ excl-excl *)
             (* step optionnel [a;b;step] ; les ranges sont first-class et itérables *)
call           = IDENT [ "?" ] "(" [ expr { "," expr } ] ")" ;
             (* appel optionnel f?(args) ≡  if f then f(args) else nil .
                f falsy (false, nil, 0, "", [], {}) → aucun appel, résultat nil, ARGS NON ÉVALUÉS ;
                f appelable → appel ; f truthy non appelable → erreur (appel standard).
                Implémenté avec JUMP_IF_FALSE + appel standard (pas d'opcode dédié).
                S'applique à toutes les formes : f?(), expr?() (ex. m["cb"]?()),
                obj.m?() (self injecté, méthode absente → nil) et super.m?(). *)

line_comment   = "##" { any \ newline } ;
block_comment  = "###" { any } "###" ;

(* NL : saut de ligne — termine tout statement.
   La continuation implicite s'applique à l'intérieur des parenthèses, crochets
   et accolades : un saut de ligne n'y termine pas le statement.
   ';' est le séparateur d'intervalle dans rangeLit ; interdit partout ailleurs. *)

NUMBER         = ( digit { [ "_" ] digit } [ "." [ digit { [ "_" ] digit } ] ] [ exponent ] )
               | ( "." digit { [ "_" ] digit } [ exponent ] )
               | ( ( "0x" | "0X" ) hexDigit { [ "_" ] hexDigit } )
               | ( ( "0o" | "0O" ) octDigit { [ "_" ] octDigit } )
               | ( ( "0b" | "0B" ) binDigit { [ "_" ] binDigit } ) ;
exponent       = ( "e" | "E" ) [ "+" | "-" ] digit { digit } ;
             (* '_' uniquement entre deux chiffres (1_000 == 1000) ; littéraux entiers → int64, sinon float *)
             (* notation scientifique : un exposant (e/E) rend le littéral flottant (1e3 == 1000.0,
                6.022e23, 2e-3 == 0.002) ; l'exposant n'admet pas de '_' et exige au moins un chiffre *)
             (* 0x.. hexa, 0o.. octal, 0b.. binaire : toujours entiers (0xFF==255, 0o10==8, 0b1010==10) ;
                pas d'exposant sur ces bases *)
             (* un littéral suivi immédiatement d'un caractère alphanumérique, '.' ou '_' est une erreur *)
hexDigit       = digit | "a" | ... | "f" | "A" | ... | "F" ;
octDigit       = "0" | ... | "7" ;
binDigit       = "0" | "1" ;
STRING         = '"' { strChar } '"' ;
strChar        = any \ ( '"' | '{' | LF ) | "\{" | "{" expr [ ":" fmtSpec ] "}" | placeholder ;
placeholder    = "{" [ digit { digit } ] [ ":" fmtSpec ] "}" ;
fmtSpec        = { "-" | "+" | " " | "#" | "0" | digit | "." } convChar ;
convChar       = "d" | "i" | "o" | "u" | "x" | "X" | "c"
               | "e" | "E" | "f" | "F" | "g" | "G" | "a" | "A" | "s" ;
                 (* "{" expr [":"fmtSpec] "}" : INTERPOLATION — évalue expr et insère sa
                    représentation ; fmtSpec (spec de conversion C sans le '%') applique un
                    format (ex. {x:.3f}, {n:04x}). Le ':' séparateur est celui de PREMIER
                    niveau (les ':' d'un map-littéral {a:1} imbriqué sont préservés).
                    placeholder = "{" vide ou entier ≥ 1 [":"fmtSpec] "}" ({}, {1}, {2:.3f}) — index 1-based :
                    laissé LITTÉRAL dans la chaîne, destiné à la substitution POSITIONNELLE
                    de printf (rempli par les arguments). "\{" : accolade littérale.
                    Une chaîne sans interpolation est un token STRING (elle peut contenir des
                    placeholders positionnels) ; une chaîne avec "{expr}" produit une séquence
                    INTERP_START/MID/END. Le formatage {expr:spec} / {N:spec} partage le même
                    moteur (fonction interne __fmt / printf). *)
BOOL           = "true" | "false" ;
             (* TYPE À PART ENTIÈRE, étanche : `true` n'est pas l'entier 1, donc
                true <> 1 et false <> 0. L'arithmétique et les comparaisons d'ordre sur un
                booléen sont une erreur d'exécution, comme sur nil.
                Produit par `not`, par les comparaisons (== <> < > <= >=) et par les
                littéraux ; affiché "true"/"false".
                « Le vide est faux » demeure : 0, "", [] et {} sont falsy sans être false.
                Il n'existe pas de conversion `bool(v)` — `not not v` en tient lieu. *)
NIL            = "nil" ;
IDENT          = ( letter | "_" ) { letter | digit | "_" } ;

digit          = "0" | ... | "9" ;
letter         = "a" | ... | "z" | "A" | ... | "Z" ;

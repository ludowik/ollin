#!/bin/bash
# Refuses a commit whose test suite does not pass (project rule: `tests/run.sh` before
# EVERY commit, with no exception), and whose sample tests do not pass either (`tests/samples.sh`,
# see below). Versioned in the repository, so present after a fresh clone; wired in through
# `core.hooksPath`, set at session start.
#
# The binary is rebuilt first: without that, an uncompiled C++ change would be validated by
# the OLD `build/ollin` — a green test saying nothing about the code committed.
#
# The way round it, to be kept for cases where the suite cannot run (no compiler):
#   git commit --no-verify
set -uo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root" || exit 1

if [ ! -f tests/run.sh ]; then
    exit 0   # a partial repository (a tooling worktree): nothing to check
fi

if command -v cmake >/dev/null 2>&1 && [ -d build ]; then
    if ! cmake --build build -j"$(nproc 2>/dev/null || echo 4)" --target ollin >/tmp/pre-commit-build.log 2>&1; then
        echo "pre-commit: the build failed — commit refused (details in /tmp/pre-commit-build.log)"
        tail -15 /tmp/pre-commit-build.log
        exit 1
    fi
fi

if ! bash tests/run.sh >/tmp/pre-commit-tests.log 2>&1; then
    echo "pre-commit: tests failed — commit refused."
    grep -E "FAIL|Results:|assert" /tmp/pre-commit-tests.log | tail -15
    echo "(full output in /tmp/pre-commit-tests.log)"
    exit 1
fi

# The tests of the samples sit next to their script. A change to the engine, the tooling or a shared library
# can break any sample, so it runs them all; a change to one sample runs the tests of that sample only; a change
# elsewhere (the web app, the documentation) has none to run.
scope=""
all=0
for f in $(git diff --cached --name-only --diff-filter=d); do
    case "$f" in
        docs/samples/lib/*|src/*|libs/*|tests/*|tools/*|CMakeLists.txt) all=1 ;;
        docs/samples/*/*) scope="$scope ${f%/*}" ;;
        docs/samples/*.ol)
            stem=${f%.ol}
            scope="$scope ${stem%_test}_test.ol" ;;
    esac
done
if [ "$all" = 1 ]; then
    scope=""
elif [ -z "$scope" ]; then
    echo "pre-commit: tests OK"
    exit 0
fi
if ! bash tests/samples.sh $scope >/tmp/pre-commit-samples.log 2>&1; then
    echo "pre-commit: sample tests failed — commit refused."
    grep -E "FAIL|assert" /tmp/pre-commit-samples.log | tail -15
    echo "(full output in /tmp/pre-commit-samples.log)"
    exit 1
fi

echo "pre-commit: tests OK"
exit 0

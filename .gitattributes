# Normalises line endings: LF in the repository, automatic conversion on checkout
* text=auto

# Sources and scripts: strictly LF
*.cpp   text eol=lf
*.h     text eol=lf
*.ol    text eol=lf
*.html  text eol=lf
*.js    text eol=lf
*.ts    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.sh    text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf

# Binaries: no conversion
*.wasm  binary
*.png   binary
*.jpg   binary
*.ico   binary

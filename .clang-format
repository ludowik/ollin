---
BasedOnStyle: LLVM
ColumnLimit: 120
IndentWidth: 4
TabWidth: 4
UseTab: Never

# K&R braces: the opening one on the same line
BreakBeforeBraces: Attach

# No column alignment of declarations or assignments
AlignConsecutiveDeclarations: None
AlignConsecutiveAssignments: None

# No function body on a single line
AllowShortFunctionsOnASingleLine: None
AllowShortBlocksOnASingleLine: Never
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false

# Pointers and references stuck to the type
PointerAlignment: Left

# A space before ( only for the control keywords (if, while, for…)
SpaceBeforeParens: ControlStatements

# Includes: the order is preserved as written (do not reorder — robin_hood.h needs <cstdint> first)
IncludeBlocks: Preserve
